# Origin of the FilyBase inference gateway (server-side only — never exposed to the browser).
# The browser talks only to this Next app; /api/v1/* proxies to BACKEND_ORIGIN.
BACKEND_ORIGIN=http://localhost:8080

# Public app config
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_APP_NAME=FilyBase
NEXT_PUBLIC_APP_URL=http://localhost:3000
